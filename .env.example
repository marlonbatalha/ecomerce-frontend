# Copie este arquivo para .env.local (não versionado) e ajuste os valores.
# Ver docs/plano-ecommerce.md, seção 1.7 (Integração com o Backend).

# URL da API própria usada em chamadas client-side (exposta ao browser).
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL da API própria usada em chamadas server-side/SSR (não exposta ao browser).
API_URL=http://localhost:4000

# "enabled" liga o mock de API (MSW) no browser durante o dev, quando a API
# própria ainda não está disponível. Ver src/mocks/init.ts.
NEXT_PUBLIC_API_MOCKING=disabled
