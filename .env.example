# Copie este arquivo para .env.local (não versionado) e ajuste os valores.
# Ver docs/plano-ecommerce.md, seção 1.7 (Integração com o Backend).

# URL da API própria. Só usada server-side (Server Components/Route Handlers/
# Server Actions) — NUNCA prefixar com NEXT_PUBLIC_, isso inlinearia a URL
# real do backend (host do App Service/VM em produção) no bundle do cliente.
BACKEND_URL=http://localhost:4000

# "enabled" liga o mock de API (MSW), tanto no browser (src/mocks/init.ts)
# quanto no servidor/SSR (src/instrumentation.ts). Deixe "enabled" até a API
# própria estar disponível; depois, troque para "disabled".
NEXT_PUBLIC_API_MOCKING=enabled
